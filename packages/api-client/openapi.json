{
  "components": {
    "schemas": {
      "EntryDetailSchema": {
        "description": "出走馬の詳細（確定済みなら成績を含む）。",
        "properties": {
          "finish_pos": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finish Pos"
          },
          "frame_no": {
            "title": "Frame No",
            "type": "integer"
          },
          "horse_no": {
            "title": "Horse No",
            "type": "integer"
          },
          "ketto_num": {
            "title": "Ketto Num",
            "type": "string"
          },
          "pci_actual": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pci Actual"
          },
          "running_style": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Running Style"
          }
        },
        "required": [
          "horse_no",
          "frame_no",
          "ketto_num"
        ],
        "title": "EntryDetailSchema",
        "type": "object"
      },
      "ForecastSchema": {
        "description": "レース展開予想（想定RPCI + 展開シナリオ + 各馬 PAI）。",
        "properties": {
          "beneficiaries": {
            "default": [],
            "items": {
              "type": "integer"
            },
            "title": "Beneficiaries",
            "type": "array"
          },
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "forecast_reasons": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ReasonSchema"
            },
            "title": "Forecast Reasons",
            "type": "array"
          },
          "front_runners": {
            "default": [],
            "items": {
              "type": "integer"
            },
            "title": "Front Runners",
            "type": "array"
          },
          "horses": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/HorseFitSchema"
            },
            "title": "Horses",
            "type": "array"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "pace_label": {
            "title": "Pace Label",
            "type": "string"
          },
          "predicted_rpci": {
            "title": "Predicted Rpci",
            "type": "number"
          },
          "race_key": {
            "title": "Race Key",
            "type": "string"
          },
          "scenario_detail": {
            "title": "Scenario Detail",
            "type": "string"
          },
          "scenario_headline": {
            "title": "Scenario Headline",
            "type": "string"
          }
        },
        "required": [
          "race_key",
          "predicted_rpci",
          "pace_label",
          "confidence",
          "model_version",
          "scenario_headline",
          "scenario_detail"
        ],
        "title": "ForecastSchema",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthSchema": {
        "properties": {
          "status": {
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthSchema",
        "type": "object"
      },
      "HorseFitSchema": {
        "description": "馬単位の展開適性（PAI）。",
        "properties": {
          "fit_label": {
            "title": "Fit Label",
            "type": "string"
          },
          "horse_no": {
            "title": "Horse No",
            "type": "integer"
          },
          "pai": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Pai",
            "type": "number"
          },
          "reasons": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ReasonSchema"
            },
            "title": "Reasons",
            "type": "array"
          },
          "running_style": {
            "title": "Running Style",
            "type": "string"
          }
        },
        "required": [
          "horse_no",
          "running_style",
          "pai",
          "fit_label"
        ],
        "title": "HorseFitSchema",
        "type": "object"
      },
      "RaceDetailSchema": {
        "description": "レース詳細（core 層の情報 + 確定指標）。",
        "properties": {
          "distance_m": {
            "title": "Distance M",
            "type": "integer"
          },
          "entries": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/EntryDetailSchema"
            },
            "title": "Entries",
            "type": "array"
          },
          "field_size": {
            "title": "Field Size",
            "type": "integer"
          },
          "grade": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grade"
          },
          "jyo_cd": {
            "title": "Jyo Cd",
            "type": "string"
          },
          "pci3_actual": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pci3 Actual"
          },
          "race_class": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Race Class"
          },
          "race_date": {
            "title": "Race Date",
            "type": "string"
          },
          "race_key": {
            "title": "Race Key",
            "type": "string"
          },
          "rpci_actual": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rpci Actual"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "track_condition": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Track Condition"
          },
          "track_type": {
            "title": "Track Type",
            "type": "string"
          },
          "weather": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Weather"
          }
        },
        "required": [
          "race_key",
          "race_date",
          "jyo_cd",
          "distance_m",
          "track_type",
          "status",
          "field_size"
        ],
        "title": "RaceDetailSchema",
        "type": "object"
      },
      "ReasonSchema": {
        "description": "説明可能性の根拠（要因コード・説明・寄与度）。",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "contribution": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contribution"
          },
          "description": {
            "title": "Description",
            "type": "string"
          }
        },
        "required": [
          "code",
          "description"
        ],
        "title": "ReasonSchema",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "競馬展開予想 SaaS — 想定RPCI・PAI・展開シナリオを提供する REST API",
    "title": "PCI App API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/races/{race_key}": {
      "get": {
        "description": "レースの基本情報・出走馬・確定指標を返す。",
        "operationId": "get_race_detail_api_v1_races__race_key__get",
        "parameters": [
          {
            "description": "16桁のレースキー",
            "in": "path",
            "name": "race_key",
            "required": true,
            "schema": {
              "description": "16桁のレースキー",
              "pattern": "^\\d{16}$",
              "title": "Race Key",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RaceDetailSchema"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Race Detail",
        "tags": [
          "races"
        ]
      }
    },
    "/api/v1/races/{race_key}/forecast": {
      "get": {
        "description": "未確定レースの展開予想（想定RPCI・展開シナリオ・各馬 PAI）を返す。",
        "operationId": "get_race_forecast_api_v1_races__race_key__forecast_get",
        "parameters": [
          {
            "description": "16桁のレースキー",
            "in": "path",
            "name": "race_key",
            "required": true,
            "schema": {
              "description": "16桁のレースキー",
              "pattern": "^\\d{16}$",
              "title": "Race Key",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastSchema"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Race Forecast",
        "tags": [
          "races"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthSchema"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    }
  }
}
