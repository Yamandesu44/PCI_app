  "info": {
    "description": "競馬展開予想 SaaS — 想定RPCI・PAI・展開シナリオを提供する REST API",
    "title": "PCI App API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/races": {
      "get": {
        "description": "新しい順にレース一覧を返す。date 指定時はその日のレースのみ返す。",
        "operationId": "list_races_api_v1_races_get",
        "parameters": [
          {
            "description": "取得件数の上限",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "description": "取得件数の上限",
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "絞り込む開催日（YYYY-MM-DD）",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "絞り込む開催日（YYYY-MM-DD）",
              "title": "Date"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RaceSummarySchema"
                  },
                  "title": "Response List Races Api V1 Races Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Races",
        "tags": [
          "races"
        ]
      }
    },
    "/api/v1/races/dates": {
      "get": {
        "description": "全開催日を昇順で返す（カレンダー表示用）。",
        "operationId": "list_race_dates_api_v1_races_dates_get",
