{
  "name": "@pci/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "PCI App — OpenAPI 由来の型共有クライアント（FastAPI ↔ Next.js）",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.d.ts"
  },
  "files": [
    "src",
    "openapi.json"
  ],
  "scripts": {
    "generate": "openapi-typescript ./openapi.json -o ./src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.0"
  }
}
