# FastAPI バックエンドのベース URL（サーバコンポーネントから参照）。
# 本番は Vercel の環境変数に設定する。生データ・認証情報は含めない。
API_BASE_URL=http://127.0.0.1:8000

# ---- 少人数ロケテスト（本番だけ設定）----
# Webを共有Basic認証で保護する。片方だけ設定すると503で閉じる。
# BETA_ACCESS_USER=friend
# BETA_ACCESS_PASSWORD=replace-with-a-long-random-password

# FastAPIのPUBLIC_API_TOKENと同じ値を設定し、サーバー間通信を保護する。
# API_ACCESS_TOKEN=replace-with-a-different-random-token
