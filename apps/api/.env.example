# ---- ローカル開発 (docker-compose.yml の DB に対応) ----
# 実際の .env はコミットしない（.gitignore に記載済み）

DATABASE_URL=postgresql+psycopg://pci:pci_dev@localhost:5432/pci_dev

# ---- 本番環境（Railway / Render / Fly.io など）で設定する変数 ----
# DATABASE_URL=postgresql+psycopg://<user>:<pass>@<host>:5432/<db>
#
# 以下の変数が将来追加された際も同様に .env で管理すること:
# ANTHROPIC_API_KEY=...   # LLM コメント生成 (comment-llm-v*) — MVP では不要
