# ---- ローカル開発 (docker-compose.yml の DB に対応) ----
# 実際の .env はコミットしない（.gitignore に記載済み）

DATABASE_URL=postgresql+pg8000://pci:pci_dev@localhost:5432/pci_dev

# ---- 本番環境（Railway / Render / Fly.io など）で設定する変数 ----
# DATABASE_URL=postgresql+pg8000://<user>:<pass>@<host>:5432/<db>

# ---- LLM コメント生成（任意）----
# 既定は外部APIを呼ばないルールベース（comment-v2）。APIキーが残っていても呼び出さない。
COMMENT_GENERATOR_MODE=rule
# Geminiを使う場合だけ gemini へ変更し、APIキーも設定する（comment-gemini-v3）。
# 無料枠・料金はGoogle公式情報を確認する。
# COMMENT_GENERATOR_MODE=gemini
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.5-flash

# ---- Ingest API 認証（ingestion-worker からのデータ投入保護）----
# 未設定（空）の場合は開発モード（認証スキップ）。本番環境では必ず設定すること。
# ingestion-worker 側の INGEST_TOKEN と同じ値を設定する。
# INGEST_TOKEN=your-random-secure-token-here

# ---- 公開参照API認証（少人数ロケテスト）----
# 未設定ならローカル開発モード。公開環境では必ず設定し、Web側API_ACCESS_TOKENと同じ値にする。
# /health と /ready、および別認証の /internal/ingest/* はこのトークンの対象外。
# PUBLIC_API_TOKEN=replace-with-a-random-server-token

# ---- CORS（ブラウザから直接叩くことを許すオリジン）----
# web は Next.js のサーバコンポーネントから API を呼ぶため、通常の動作に CORS は要らない。
# 既定はローカル開発の2つだけ。空にすれば CORS を一切許可しない。
# 公開環境でブラウザから直接叩く必要がある場合のみ、そのオリジンを明示する。
# 以前は全許可(*)だったが、それだと任意のサイトからデータを読み出せてしまう。
# CORS_ALLOW_ORIGINS=https://your-app.vercel.app

# ---- レート制限（公開参照API）----
# クライアント単位の1分あたり上限。0 で無効。無制限スクレイピングの抑止が目的。
# RATE_LIMIT_PER_MINUTE=120
#
# 前段に置く信頼できるプロキシの段数。
# PaaS のロードバランサ配下では接続元IPが常にプロキシになり、全利用者が同じキーへ
# 集約されてしまう（実質「全体で N 回」になる）。実際の構成の段数を設定すること。
# 設定しない限り X-Forwarded-For は信用しない（詐称で回避されるため）。
# RATE_LIMIT_TRUSTED_PROXIES=1
