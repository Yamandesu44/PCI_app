# ---- ローカル開発 (docker-compose.yml の DB に対応) ----
# 実際の .env はコミットしない（.gitignore に記載済み）

DATABASE_URL=postgresql+psycopg2://pci:pci_dev@localhost:5432/pci_dev

# ---- 本番環境（Railway / Render / Fly.io など）で設定する変数 ----
# DATABASE_URL=postgresql+psycopg2://<user>:<pass>@<host>:5432/<db>

# ---- LLM コメント生成（任意）----
# Gemini API キーを設定すると、展開コメントが AI 生成（comment-gemini-v1）になる。
# 未設定の場合はルールベース（comment-v1）にフォールバックするため設定必須ではない。
# Google AI Studio (https://aistudio.google.com) で無料取得可能。
# GEMINI_API_KEY=AIza...

# ---- Ingest API 認証（ingestion-worker からのデータ投入保護）----
# 未設定（空）の場合は開発モード（認証スキップ）。本番環境では必ず設定すること。
# ingestion-worker 側の INGEST_TOKEN と同じ値を設定する。
# INGEST_TOKEN=your-random-secure-token-here
