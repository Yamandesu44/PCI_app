# ingestion-worker 環境変数
# このファイルを .env にコピーして、ローカルだけで設定してください。
# JV-Link 利用キーは絶対にコミットしないこと。

# Ingest API のベース URL
API_BASE_URL=http://localhost:8000

# Bearer トークン（API 側の INGEST_TOKEN と一致させる。未設定なら開発モードで認証スキップ）
INGEST_TOKEN=

# JRA-VAN DataLab の利用キー（--mode jvlink 時のみ必要・Windows 環境）
JV_LINK_SID=YOUR_JVLINK_SID_HERE
