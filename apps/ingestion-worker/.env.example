# ingestion-worker 環境変数
# このファイルを .env にコピーして、ローカルだけで設定してください。
# JV-Link 利用キーは絶対にコミットしないこと。

# Ingest API のベース URL
API_BASE_URL=http://localhost:8000

# Bearer トークン（API 側の INGEST_TOKEN と一致させる。未設定なら開発モードで認証スキップ）
INGEST_TOKEN=

# JRA-VAN DataLab の利用キー（--mode jvlink 時のみ必要・Windows 環境）
JV_LINK_SID=YOUR_JVLINK_SID_HERE

# バッチ失敗時の通知先（Slack Incoming Webhook 等。未設定なら通知しない）
NOTIFY_WEBHOOK_URL=

# mykeibadb MySQL 読み取り（--mode mykeibadb 時）
# DSN を使う場合: mysql://user:password@localhost:3306/mykeibadb
MYKEIBADB_DSN=
MYKEIBADB_HOST=localhost
MYKEIBADB_PORT=3306
MYKEIBADB_USER=root
MYKEIBADB_PASSWORD=
MYKEIBADB_DATABASE=mykeibadb
MYKEIBADB_CHARSET=utf8mb4
# カンマ区切りで除外する race_key を追加できます。
MYKEIBADB_EXCLUDE_RACE_KEYS=

# mykeibadb.exe（実行エンジン・wなし）のフルパス。
# scripts/run_mykeibadb_full_sync.ps1 が Task Scheduler から呼び出す際に使用する。
# wmykeibadb.exe で設定済みの mykeibadb.ini が同じフォルダにあること。
# 例: C:\Users\yourname\Downloads\mykeibadb_v4.3\mykeibadb.exe
MYKEIBADB_EXE_PATH=
